DEMO_MODE=1
SECRET_KEY=
ALLOWED_HOSTS=
# Required for host-side commands; Compose injects its own PostgreSQL URL.
# VERDICT only supports PostgreSQL: postgres://user:pass@host:port/name.
# Point this at the Compose 'db' service (run
# app/test commands with `docker compose exec web ...` if db has no published
# host port) or an isolated local/test PostgreSQL container. See AGENTS.md.
DATABASE_URL=
POSTGRES_PASSWORD=verdict
VERDICT_PORT=8080
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Blank EMAIL_HOST keeps messages in the private organizer/admin outbox.
# DEMO_MODE=1 always uses the outbox, even when an SMTP host is configured.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
# For implicit TLS use port 465, EMAIL_USE_SSL=1 and EMAIL_USE_TLS=0.
DEFAULT_FROM_EMAIL=no-reply@verdict.local

# Test-only local webhook receivers: this bypasses private-network SSRF checks.
# Keep 0 in production; only set 1 in an isolated test/demo environment.
WEBHOOKS_ALLOW_PRIVATE=0
