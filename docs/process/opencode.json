{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "git push*": "deny",
      "git commit*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "rm -rf*": "deny",
      "Remove-Item*": "deny",
      "rmdir*": "deny",
      "del *": "deny",
      "format*": "deny",
      "docker system prune*": "deny",
      "docker volume rm*": "deny"
    }
  }
}
